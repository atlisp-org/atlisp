[Unit]
Description=@lisp 自动化员工服务
After=network-online.target vllm-cuda.service
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=6

[Service]
Type=simple
User=vitalgg
Group=vitalgg
WorkingDirectory=/home/vitalgg/atlisp
ExecStart=/home/vitalgg/atlisp/automation/work-service.sh
Restart=always
RestartSec=10

# 环境变量
EnvironmentFile=-/etc/atlisp/atlisp-worker.env
Environment=HOME=/home/vitalgg
Environment=PATH=/usr/local/bin:/usr/bin:/bin
Environment=VLLM_REQUIRED=true
Environment=VLLM_WAIT_TIMEOUT=60

# 日志
StandardOutput=journal
StandardError=journal
SyslogIdentifier=atlisp-worker

# 资源限制
MemoryMax=2G
CPUQuota=80%

# 安全加固
NoNewPrivileges=true
ReadWritePaths=/home/vitalgg/atlisp /tmp

[Install]
WantedBy=multi-user.target
